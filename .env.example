# AI API server configuration (keep all provider keys on the server)
# gemini | openai-compatible
AI_PROVIDER=gemini

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible provider (Groq, Ollama local, or another compatible endpoint)
# For Ollama running on the SAME machine as this API: http://localhost:11434/v1
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2

PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Vercel frontend configuration
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
